# ---------------------------------------------------------------------------
# force=true 是刻意配置，请勿删除。
#
# koffi 把各平台的原生二进制拆成独立的可选包（@koromix/koffi-<os>-<arch>），
# 并在这些包的 package.json 里写了 os / cpu 字段。npm 默认只安装与当前机器
# 匹配的那一个 —— 在 macOS / Linux 上开发时，Windows 用的
# @koromix/koffi-win32-x64 会被直接跳过，于是打出来的 Windows 包里缺少
# 调用 user32.dll 所需的 koffi.node，桌面层挂载在用户机器上必然失败。
#
# package.json 已把 @koromix/koffi-win32-x64 显式列入 dependencies，
# 配合这里的 force=true，才能在 macOS / Linux 上交叉打包出可用的 Windows 包。
#
# 代价是同时关掉了 peer 依赖冲突、engine 版本等校验。本项目是应用而非库，
# 可以接受；若某天出现依赖冲突报错被吞掉，先检查这里。
# ---------------------------------------------------------------------------
force=true
